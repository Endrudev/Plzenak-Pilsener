PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eventhub
DB_USER=postgres
DB_PASSWORD=yourpassword

JWT_SECRET=your-very-long-random-secret-min-32-chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=yourpassword
FRONTEND_URL=http://localhost:5173

# Jen pro vývoj: víc pokusů o přihlášení za 15 minut. Bez proměnné platí 5 (produkce).
LOGIN_RATE_LIMIT_MAX=100

R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-public-url.r2.dev

# Token importéru návrhů akcí (POST /api/candidates). Smí jen odesílat návrhy ke schválení.
# Vygeneruj dlouhou náhodnou hodnotu, např. `openssl rand -base64 48`. Bez něj je import vypnutý.
IMPORTER_TOKEN=

# Odkud serverový renderer (src/routes/render.js) bere index.html z buildu frontendu.
# V Compose platí výchozí http://frontend/index.html a proměnná se nenastavuje. Lokálně
# jen pro vyzkoušení rendereru: `npm run build` a `npx vite preview` ve frontend/, pak
# SITE_TEMPLATE_URL=http://localhost:4173/index.html a curl na http://localhost:3001/akce.
# SITE_TEMPLATE_URL=

# Klíč IndexNow (lib/indexNow.js). Jen produkce (Doppler config prd), lokálně nechat
# prázdný: IndexNow je pak vypnutý a lokální úpravy akcí se vyhledávačům neoznamují.
# INDEXNOW_KEY=
